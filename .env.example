# 选择 OpenAI 兼容或 Anthropic 兼容的模型提供方。
LLM_PROVIDER=openai

# OpenAI 兼容 API 配置。
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
LLM_WIRE_API=responses
# 第三方中转不支持原生函数调用时，改用 prompt。
LLM_TOOL_MODE=native

# Anthropic 兼容 Messages API 配置。
# 使用新生成的令牌，不要提交真实凭据。
ANTHROPIC_BASE_URL=https://api.example.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# 也兼容旧名称 LLM_BASE_URL 和 LLM_API_KEY。

# 运行时选项。
MAX_STEPS=6
TOOL_APPROVAL=ask
