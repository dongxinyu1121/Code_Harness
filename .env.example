# Select either the OpenAI-compatible or Anthropic-compatible provider.
LLM_PROVIDER=openai

# OpenAI-compatible API configuration.
OPENAI_BASE_URL=https://api.chiyi.cc
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5
LLM_WIRE_API=chat_completions
# Use prompt when a third-party relay rejects native function calling.
LLM_TOOL_MODE=native

# Anthropic-compatible Messages API configuration.
# Use a newly generated token. Do not commit real credentials.
ANTHROPIC_BASE_URL=https://api.example.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# The legacy names LLM_BASE_URL and LLM_API_KEY are also supported.

# Runtime options
MAX_STEPS=6
TOOL_APPROVAL=ask
